{
  "id": "opencode-go",
  "version": "1.0.1",
  "description": "Speaks to OpenCode Zen/Go gateways as OpenCode does.",
  "api_version": 2,
  "entry": "plugin.js",
  "requires": ["kv.v1", "json.lossless.v1", "encoding.v1", "sse.events.v2"],
  "permissions": [],
  "config_schema": {
    "type": "object",
    "properties": {
      "user_agent": { "type": "string", "default": "opencode/1.19.0 ai-sdk/provider-utils/4.0.23 runtime/bun/1.3.14" },
      "client": { "type": "string", "default": "cli" },
      "project": { "type": "string", "default": "global" },
      "free_tier": { "type": "boolean", "default": true },
      "session_ttl_ms": { "type": "integer", "default": 0, "minimum": 0, "maximum": 2592000000 },
      "gate_path_prefix": { "type": "string", "default": "" }
    },
    "additionalProperties": false
  }
}
